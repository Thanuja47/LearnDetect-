{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/doctors/[id]",
      "regex": "^/doctors/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/doctors/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/parent-dashboard/children/[id]",
      "regex": "^/parent\\-dashboard/children/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/parent\\-dashboard/children/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/parent-dashboard/reports/[reportId]",
      "regex": "^/parent\\-dashboard/reports/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPreportId": "nxtPreportId"
      },
      "namedRegex": "^/parent\\-dashboard/reports/(?<nxtPreportId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/teacher-dashboard/students/[id]",
