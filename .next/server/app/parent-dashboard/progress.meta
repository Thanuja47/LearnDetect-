{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/parent-dashboard/layout,_N_T_/parent-dashboard/progress/layout,_N_T_/parent-dashboard/progress/page,_N_T_/parent-dashboard/progress"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/parent-dashboard/progress/__PAGE__",
    "/parent-dashboard/progress",
    "/parent-dashboard",
    "/_index",
    "/_head"
  ]
}