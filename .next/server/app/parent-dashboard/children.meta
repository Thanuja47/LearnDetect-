{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/parent-dashboard/layout,_N_T_/parent-dashboard/children/layout,_N_T_/parent-dashboard/children/page,_N_T_/parent-dashboard/children"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/parent-dashboard/children/__PAGE__",
    "/parent-dashboard/children",
    "/parent-dashboard",
    "/_index",
    "/_head"
  ]
}